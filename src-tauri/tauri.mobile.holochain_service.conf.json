{
  "productName": "Volla Messages",
  "identifier": "com.volla.messages.service",
  "version": "0.8.4",
  "build": {
    "beforeBuildCommand": "npm run build -w ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/colon/32x32.png",
      "icons/colon/128x128.png",
      "icons/colon/128x128@2x.png",
      "icons/colon/icon.icns",
      "icons/colon/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  }
}